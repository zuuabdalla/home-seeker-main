<% if (flash.length) { %>
<div class="flash-stack" role="status">
  <% flash.forEach(function (f) { %>
  <div class="alert alert-<%= f.type %>" data-autoclose>
    <i class="bi <%= f.type === 'success' ? 'bi-check-circle-fill' : f.type === 'error' ? 'bi-exclamation-octagon-fill' : 'bi-info-circle-fill' %>"></i>
    <div><%= f.message %></div>
    <button type="button" class="close" aria-label="Dismiss" data-dismiss>&times;</button>
  </div>
  <% }) %>
</div>
<% } %>
