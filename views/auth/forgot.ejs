<%- include('../partials/doc-start') %>
<main class="auth">
  <%- include('_art') %>
  <div class="auth-form">
    <div class="inner">
      <div class="empty" style="padding:0;text-align:left">
        <div class="icon"><i class="bi bi-key"></i></div>
      </div>
      <h1>Forgot your password?</h1>
      <p class="sub">For your security, password resets are handled by our support team. Send us a message from the email address on your account and we'll help you get back in, usually within a few hours.</p>
      <a href="/contact" class="btn btn-primary btn-lg btn-block"><i class="bi bi-envelope"></i> Contact support</a>
      <p class="auth-switch"><a href="/login"><i class="bi bi-arrow-left"></i> Back to log in</a></p>
    </div>
  </div>
</main>
<%- include('../partials/doc-end') %>
